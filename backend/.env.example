# Backend-only configuration. This file may contain secrets; never expose it to the browser.
F2F_ENVIRONMENT=development
F2F_LOG_LEVEL=INFO
F2F_DEVELOPMENT_IDENTITY_ENABLED=true
F2F_DEVELOPMENT_USER_ID=20000000-0000-4000-8000-000000000001
F2F_DATABASE_URL=postgresql+asyncpg://file2formai:file2formai_dev@localhost:5432/file2formai
F2F_DATABASE_CONNECT_TIMEOUT_SECONDS=5
F2F_DATABASE_POOL_TIMEOUT_SECONDS=5
F2F_DATABASE_READINESS_TIMEOUT_SECONDS=5
F2F_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
